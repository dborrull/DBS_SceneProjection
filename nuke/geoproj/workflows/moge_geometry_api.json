{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "plate.png"}
  },
  "2": {
    "class_type": "LoadMoGeModel",
    "inputs": {"model_name": "moge_2_vitl_normal_fp16.safetensors"}
  },
  "3": {
    "class_type": "MoGeInference",
    "inputs": {
      "moge_model": ["2", 0],
      "image": ["1", 0],
      "resolution_level": 9,
      "fov_x_degrees": 0.0,
      "batch_size": 1,
      "force_projection": true,
      "apply_mask": true,
      "refine_steps": 3
    }
  },
  "4": {
    "class_type": "SaveMoGeGeometry",
    "inputs": {"moge_geometry": ["3", 0], "filename_prefix": "geo_projection/moge"}
  }
}
